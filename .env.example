# Copied to .env by `make setup`. .env is gitignored; never commit secrets.

# Local Postgres started by `make db` (docker compose). Change the port if 5432 is taken.
CPGOS_DB_PORT=5432
CPGOS_DATABASE_URL=postgresql://cpgos:cpgos_local_only@localhost:5432/cpgos

# Ports for `make api` and `make web`. Not 3000/8000: those are often taken (e.g. Grafana).
CPGOS_API_PORT=8100
CPGOS_WEB_PORT=3100

# Phase 2: the API key for the document-extraction tier (Claude). Leave empty until then.
ANTHROPIC_API_KEY=
